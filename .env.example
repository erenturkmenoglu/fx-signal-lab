# FX Signal Lab - configuration.  Copy to .env and fill in.  Never commit .env.

# --- required ------------------------------------------------------------------------------
# Database password (letters and digits only: it is embedded in a connection URL).
POSTGRES_PASSWORD=change-me

# Massive (formerly Polygon.io) API key.  Live FX quotes need the Currencies Starter plan
# or higher.  Without a key the application starts, shows "No data provider" and collects
# nothing - it never falls back to synthetic data on its own.
MASSIVE_API_KEY=

# --- data provider -------------------------------------------------------------------------
# massive = real market data.   mock = synthetic prices for development (clearly labelled).
DATA_PROVIDER=massive
# Database used by the app container: fxlab for Massive, fxlab_mock for mock mode.
FXLAB_DB=fxlab

# Free "Currencies Basic" plan: 5 REST calls per minute.  0 = no client-side limit.
MASSIVE_REST_MAX_CALLS_PER_MIN=0

# --- storage -------------------------------------------------------------------------------
PERSIST_RAW_TICKS=true
# Days to keep raw quote ticks (0 = forever).  1-second observations and bars are kept forever
# by default (RETENTION_OBS_DAYS=0).
RETENTION_TICKS_DAYS=30
RETENTION_OBS_DAYS=0
COMPRESS_AFTER_DAYS=7
# Changes to the three values above take effect at the next restart.

# --- recovery ------------------------------------------------------------------------------
# Outages longer than this are recorded but not backfilled automatically.
GAP_BACKFILL_MAX_HOURS=72

# --- logging -------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# Pair-specific settings (pip size, stale thresholds, spreads, sessions) are in
# config/instruments.yaml, not here.
